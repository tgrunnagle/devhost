#!/usr/bin/env bash
# Fake lsof for tests. $FAKE_DIR/busy-ports holds lines "PORT COMMAND PID" for
# ports that have a local listener; anything else is free.
set -u
port=""
for arg in "$@"; do
    case "$arg" in
        -iTCP:*) port="${arg#-iTCP:}" ;;
    esac
done
[[ -n "$port" && -f "$FAKE_DIR/busy-ports" ]] || exit 1
line="$(awk -v p="$port" '$1 == p { print $2, $3; exit }' "$FAKE_DIR/busy-ports")"
[[ -n "$line" ]] || exit 1
echo "COMMAND     PID USER   FD   TYPE DEVICE SIZE/OFF NODE NAME"
echo "$line alice    6u  IPv4 0x1      0t0  TCP 127.0.0.1:$port (LISTEN)"
