#!/usr/bin/env bash
# Fake docker CLI for tests, run directly or "on the VM" by the fake ssh.
# Behaviour is driven by files in $FAKE_DIR:
#   ps               lines "CONTAINER_ID NAME" of running containers
#   port.<id>        `docker port <id>` output for that container; <id> may be a
#                    prefix of the ID asked for, like the real CLI accepts
#   events           lines "ACTION ID NAME" to emit from `docker events`
#   events-wait-for  path of a file to wait for (up to 30s) before emitting them
#   events-hold      seconds to keep `docker events` open after emitting (default 30)
#   unreachable      if present, every command fails like a dead daemon
#   ps-fail          if present, only `docker ps --no-trunc ...` (reconcile) fails
# Only the --format templates the helper relies on are accepted, so a changed
# template fails here rather than silently printing the canned output.
# Every invocation is appended to $FAKE_DIR/docker.log.
set -u
echo "docker $*" >> "$FAKE_DIR/docker.log"

args=() format=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --context) shift 2 ;;
        --format) format="$2"; shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done

bad_format() {
    echo "fake docker: unsupported --format for ${args[0]}: '$format'" >&2
    exit 1
}

if [[ -f "$FAKE_DIR/unreachable" && "${args[0]}" != context ]]; then
    echo "error during connect: dial tcp: connection refused" >&2
    exit 1
fi

case "${args[0]}" in
    context)
        [[ "$format" == '{{.Endpoints.docker.Host}}' ]] || bad_format
        echo "ssh://${FAKE_ENDPOINT:-alice@devhost}"
        ;;
    ps)
        if [[ -f "$FAKE_DIR/ps-fail" && " ${args[*]} " == *" --no-trunc "* ]]; then
            echo "error during connect: EOF" >&2
            exit 1
        fi
        case "$format" in
            ''|'{{.ID}} {{.Names}}') ;;
            *) bad_format ;;
        esac
        if [[ " ${args[*]} " == *" -q "* ]]; then
            cut -d' ' -f1 "$FAKE_DIR/ps" 2>/dev/null || true
        else
            cat "$FAKE_DIR/ps" 2>/dev/null || true
        fi
        ;;
    port)
        [[ -z "$format" ]] || bad_format
        for f in "$FAKE_DIR"/port.*; do
            [[ -e "$f" ]] || continue
            id="${f##*/port.}"
            if [[ "${args[1]}" == "$id"* ]]; then
                cat "$f"
                break
            fi
        done
        ;;
    events)
        [[ "$format" == '{{.Action}} {{.Actor.ID}} {{.Actor.Attributes.name}}' ]] || bad_format
        if [[ -f "$FAKE_DIR/events-wait-for" ]]; then
            gate="$(cat "$FAKE_DIR/events-wait-for")"
            i=0
            while [[ ! -e "$gate" && $i -lt 300 ]]; do
                sleep 0.1
                i=$((i + 1))
            done
        fi
        cat "$FAKE_DIR/events" 2>/dev/null || true
        sleep "$(cat "$FAKE_DIR/events-hold" 2>/dev/null || echo 30)"
        ;;
    version)
        case "$format" in
            ''|'{{.Server.Version}}') ;;
            *) bad_format ;;
        esac
        echo "27.0.0"
        ;;
    *)
        echo "fake docker: unsupported: ${args[*]}" >&2
        exit 1
        ;;
esac
