#!/usr/bin/env bash
# devhost: run projects unmodified against the shared devhost Docker daemon.
#
# With DOCKER_CONTEXT=devhost, published ports bound to loopback listen on the
# VM, and bind mounts resolve on the VM's filesystem. This helper makes both
# behave as if the daemon were local:
#
#   - every port the daemon publishes is mirrored onto the laptop's 127.0.0.1
#     through one SSH connection (added and removed as containers start/die)
#   - the current directory is synced to the same absolute path on the VM
#     with Mutagen, so "-v $PWD:/src" works and outputs come back
#
# Usage:
#   devhost run [--] <command...>   forward ports + sync $PWD around one command
#   devhost up                      start forwarder + sync for $PWD, stay running
#   devhost down                    stop them (forwarder stops when no dir is up)
#   devhost flush                   push local changes / pull outputs now
#   devhost status                  reachable? forwards? sync state?
#   devhost probe                   exit 0 if the daemon answers within ~3s
#
# Environment:
#   DEVHOST_CONTEXT    Docker context to use (default: devhost)
#   DEVHOST_SSH        SSH target user@host (default: the context's endpoint)
#   DEVHOST_STATE_DIR  state directory (default: ~/.devhost)
#   DEVHOST_NO_SYNC=1  mirror ports only, skip the Mutagen sync
#
# Requires: bash, ssh (OpenSSH), docker CLI, mutagen (unless DEVHOST_NO_SYNC=1).
# Works with bash 3.2 (macOS). Tested with fake docker/ssh/mutagen in tests/.

CONTEXT="${DEVHOST_CONTEXT:-devhost}"
STATE_DIR="${DEVHOST_STATE_DIR:-$HOME/.devhost}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

SOCK="$STATE_DIR/ssh.sock"
FORWARDS_FILE="$STATE_DIR/forwards"        # lines: PORT CONTAINER_ID NAME
CONFLICTS_FILE="$STATE_DIR/conflicts"      # lines: PORT|CONTAINER_ID|NAME|REASON
FWD_PID_FILE="$STATE_DIR/forwarder.pid"
FWD_READY_FILE="$STATE_DIR/forwarder.ready"
FWD_LOG="$STATE_DIR/forwarder.log"
SESSIONS_DIR="$STATE_DIR/sessions"         # one file per directory that is "up"

DEFAULT_IGNORES="node_modules .git .venv target dist"

TARGET=""        # user@host
SSH_PORT=""      # from ssh://user@host:port, if any
SSH_OPTS=(-o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3)

# ---------------------------------------------------------------- utilities

log() { printf 'devhost: %s\n' "$*" >&2; }
die() { log "$@"; exit 1; }

init_state() {
    mkdir -p "$STATE_DIR" "$SESSIONS_DIR"
    chmod 0700 "$STATE_DIR"
}

# Runs a command with a wall-clock deadline. Returns 124 on timeout.
with_deadline() {
    local secs="$1" pid ticks=0
    shift
    "$@" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        if [[ $ticks -ge $((secs * 10)) ]]; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            return 124
        fi
        sleep 0.1
        ticks=$((ticks + 1))
    done
    wait "$pid"
}

# Prints the PIDs of the direct children of $1.
children_of() {
    ps -ef | awk -v ppid="$1" '$3 == ppid { print $2 }'
}

# Kills everything under $1 (children first, so a docker events stream dies too).
kill_descendants() {
    local child
    for child in $(children_of "$1"); do
        kill_descendants "$child"
        kill "$child" 2>/dev/null || true
    done
}

kill_tree() {
    kill_descendants "$1"
    kill "$1" 2>/dev/null || true
}

pid_alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }

# -------------------------------------------------------------- ssh target

# Resolves TARGET and SSH_PORT from DEVHOST_SSH or the Docker context endpoint.
resolve_target() {
    local endpoint
    if [[ -n "${DEVHOST_SSH:-}" ]]; then
        endpoint="ssh://$DEVHOST_SSH"
    else
        endpoint="$(docker context inspect "$CONTEXT" --format '{{.Endpoints.docker.Host}}' 2>/dev/null)" ||
            die "Docker context '$CONTEXT' not found. Run client/add-devhost-context.sh first."
    fi
    parse_ssh_endpoint "$endpoint"
}

# Sets TARGET and SSH_PORT from an ssh://user@host[:port] URL.
parse_ssh_endpoint() {
    local endpoint="$1" rest
    [[ "$endpoint" == ssh://* ]] || die "context '$CONTEXT' is not an ssh:// endpoint: $endpoint"
    rest="${endpoint#ssh://}"
    rest="${rest%%/*}"
    if [[ "$rest" =~ ^(.+):([0-9]+)$ ]]; then
        TARGET="${BASH_REMATCH[1]}"
        SSH_PORT="${BASH_REMATCH[2]}"
    else
        TARGET="$rest"
        SSH_PORT=""
    fi
    [[ -n "$TARGET" ]] || die "could not parse SSH target from $endpoint"
}

ssh_port_opts() {
    if [[ -n "$SSH_PORT" ]]; then printf -- '-p\n%s\n' "$SSH_PORT"; fi
}

# ssh through the helper's own control master.
mux_ssh() {
    # shellcheck disable=SC2046  # ssh_port_opts prints zero or two words
    ssh "${SSH_OPTS[@]}" $(ssh_port_opts) -S "$SOCK" "$@"
}

master_running() { mux_ssh -O check "$TARGET" >/dev/null 2>&1; }

start_master() {
    if master_running; then
        return 0
    fi
    rm -f "$SOCK"
    # shellcheck disable=SC2046
    ssh "${SSH_OPTS[@]}" $(ssh_port_opts) -o ConnectTimeout=5 -o ControlPersist=yes \
        -M -N -f -S "$SOCK" "$TARGET" ||
        die "could not open SSH connection to $TARGET"
}

stop_master() {
    if master_running; then
        mux_ssh -O exit "$TARGET" >/dev/null 2>&1 || true
    fi
    rm -f "$SOCK"
}

# ----------------------------------------------------------- port parsing

# stdin: output of `docker port <id>`; stdout: host TCP ports, one per line,
# deduplicated. UDP can't go through an SSH forward and is skipped.
parse_published_ports() {
    local cport arrow addr port
    while read -r cport arrow addr; do
        [[ "$arrow" == '->' ]] || continue
        [[ "$cport" == */tcp ]] || continue
        port="${addr##*:}"
        [[ "$port" =~ ^[0-9]+$ ]] || continue
        echo "$port"
    done | sort -un
}

# Prints what listens on 127.0.0.1:$1 on the laptop ("COMMAND (pid N)"), or
# nothing if lsof/ss don't know of a listener.
port_holder() {
    local port="$1"
    if command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null |
            awk 'NR == 2 { printf "%s (pid %s)\n", $1, $2 }'
    elif command -v ss >/dev/null 2>&1; then
        ss -ltnpH "sport = :$port" 2>/dev/null |
            sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\).*/\1 (pid \2)/p' | head -n 1
    fi
}

# True if something on the laptop accepts connections on 127.0.0.1:$1.
port_accepts() {
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# ---------------------------------------------------------- forward state

forward_exists() { [[ -f "$FORWARDS_FILE" ]] && grep -q "^$1 " "$FORWARDS_FILE"; }

forward_record() {
    local port="$1" cid="$2" name="$3"
    forward_forget "$port"
    echo "$port $cid $name" >> "$FORWARDS_FILE"
}

forward_forget() {
    [[ -f "$FORWARDS_FILE" ]] || return 0
    grep -v "^$1 " "$FORWARDS_FILE" > "$FORWARDS_FILE.tmp" || true
    mv "$FORWARDS_FILE.tmp" "$FORWARDS_FILE"
}

forward_ports_for() {  # prints forwarded ports of container $1 (ID prefix match)
    [[ -f "$FORWARDS_FILE" ]] || return 0
    awk -v cid="$1" 'index($2, cid) == 1 || index(cid, $2) == 1 { print $1 }' "$FORWARDS_FILE"
}

record_conflict() {
    local port="$1" cid="$2" name="$3" reason="$4"
    echo "$port|$cid|$name|$reason" >> "$CONFLICTS_FILE"
    log "CONFLICT: 127.0.0.1:$port for container $name ($cid) not forwarded: $reason"
}

# Mirrors 127.0.0.1:PORT on the laptop to 127.0.0.1:PORT on the VM.
add_forward() {
    local port="$1" cid="$2" name="$3" holder
    if forward_exists "$port"; then
        forward_record "$port" "$cid" "$name"
        return 0
    fi
    holder="$(port_holder "$port")"
    if [[ -n "$holder" ]]; then
        record_conflict "$port" "$cid" "$name" "port already in use on this laptop by $holder"
        return 1
    fi
    if port_accepts "$port"; then
        record_conflict "$port" "$cid" "$name" "port already in use on this laptop (listener unknown)"
        return 1
    fi
    if mux_ssh -O forward -L "127.0.0.1:$port:127.0.0.1:$port" "$TARGET" >/dev/null 2>&1; then
        forward_record "$port" "$cid" "$name"
        log "forward 127.0.0.1:$port -> $name"
        return 0
    fi
    record_conflict "$port" "$cid" "$name" "ssh could not bind 127.0.0.1:$port"
    return 1
}

cancel_forward() {
    local port="$1"
    mux_ssh -O cancel -L "127.0.0.1:$port:127.0.0.1:$port" "$TARGET" >/dev/null 2>&1 || true
    forward_forget "$port"
    log "cancel 127.0.0.1:$port"
}

add_container_forwards() {
    local cid="$1" name="$2" port
    for port in $(docker --context "$CONTEXT" port "$cid" 2>/dev/null | parse_published_ports); do
        add_forward "$port" "$cid" "$name" || true
    done
}

cancel_container_forwards() {
    local cid="$1" port
    for port in $(forward_ports_for "$cid"); do
        cancel_forward "$port"
    done
}

# Brings forwards in line with the containers that are running right now.
reconcile() {
    local running known cid name port
    running="$(docker --context "$CONTEXT" ps --format '{{.ID}} {{.Names}}')" ||
        die "cannot list containers on context '$CONTEXT'"
    known="$(cat "$FORWARDS_FILE" 2>/dev/null || true)"
    while read -r port cid name; do
        [[ -n "$port" ]] || continue
        if ! grep -q "^$cid " <<< "$running"; then
            cancel_forward "$port"
        fi
    done <<< "$known"
    while read -r cid name; do
        [[ -n "$cid" ]] || continue
        add_container_forwards "$cid" "$name"
    done <<< "$running"
}

handle_event() {
    local action="$1" cid="$2" name="${3:-}"
    case "$action" in
        start) add_container_forwards "$cid" "$name" ;;
        die)   cancel_container_forwards "$cid" ;;
    esac
}

follow_events() {
    docker --context "$CONTEXT" events --filter type=container --filter event=start --filter event=die \
        --format '{{.Action}} {{.ID}} {{.Actor.Attributes.name}}' |
        while read -r action cid name; do
            handle_event "$action" "$cid" "$name"
        done
}

# Background process started by `up`: reconcile once, then follow events.
forwarder_main() {
    local loop_pid
    trap '' HUP
    trap 'kill_descendants $$; exit 0' TERM INT
    resolve_target
    reconcile
    touch "$FWD_READY_FILE"
    follow_events &
    loop_pid=$!
    wait "$loop_pid" || true
    log "docker events stream ended; forwarder exiting"
    rm -f "$FWD_PID_FILE" "$FWD_READY_FILE"
}

forwarder_pid() { cat "$FWD_PID_FILE" 2>/dev/null || true; }

forwarder_running() { pid_alive "$(forwarder_pid)"; }

start_forwarder() {
    local ticks=0 pid
    if forwarder_running; then
        return 0
    fi
    rm -f "$FWD_PID_FILE" "$FWD_READY_FILE" "$FORWARDS_FILE" "$CONFLICTS_FILE"
    : > "$FORWARDS_FILE"
    : > "$CONFLICTS_FILE"
    DEVHOST_SSH="$TARGET${SSH_PORT:+:$SSH_PORT}" "$SELF" _forwarder >> "$FWD_LOG" 2>&1 < /dev/null &
    pid=$!
    echo "$pid" > "$FWD_PID_FILE"
    while [[ ! -f "$FWD_READY_FILE" ]]; do
        if ! pid_alive "$pid"; then
            tail -n 5 "$FWD_LOG" >&2 || true
            die "port forwarder failed to start (see $FWD_LOG)"
        fi
        if [[ $ticks -ge 300 ]]; then
            kill_tree "$pid"
            die "port forwarder did not become ready within 30s (see $FWD_LOG)"
        fi
        sleep 0.1
        ticks=$((ticks + 1))
    done
}

stop_forwarder() {
    local pid
    pid="$(forwarder_pid)"
    if pid_alive "$pid"; then
        kill_tree "$pid"
    fi
    rm -f "$FWD_PID_FILE" "$FWD_READY_FILE"
}

# Prints recorded conflicts in a readable form; returns 1 if there were any.
report_conflicts() {
    local port cid name reason
    [[ -s "$CONFLICTS_FILE" ]] || return 0
    log "some published ports were NOT mirrored onto this laptop:"
    while IFS='|' read -r port cid name reason; do
        printf '  127.0.0.1:%s  container %s (%s): %s\n' "$port" "$name" "${cid:0:12}" "$reason" >&2
    done < "$CONFLICTS_FILE"
    log "free the port (or stop the container) and retry; forwards never move to another port."
    return 1
}

# ------------------------------------------------------------------- sync

sync_enabled() { [[ "${DEVHOST_NO_SYNC:-0}" != 1 ]]; }

sync_name() { echo "devhost-$(printf '%s' "$PWD" | cksum | cut -d' ' -f1)"; }

# Prints ignore patterns, one per line: .devhostignore if present, else defaults.
sync_ignore_patterns() {
    local pattern
    if [[ -f .devhostignore ]]; then
        sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' .devhostignore
    else
        for pattern in $DEFAULT_IGNORES; do
            echo "$pattern"
        done
    fi
}

sync_beta_url() { echo "$TARGET:${SSH_PORT:+$SSH_PORT:}$PWD"; }

sync_exists() { mutagen sync list "$(sync_name)" >/dev/null 2>&1; }

ensure_remote_dir() {
    local quoted
    quoted="$(printf '%q' "$PWD")"
    # shellcheck disable=SC2046
    if ! ssh "${SSH_OPTS[@]}" $(ssh_port_opts) -o ConnectTimeout=5 "$TARGET" "mkdir -p $quoted" 2>/dev/null; then
        log "cannot create $PWD on $TARGET."
        log "On the VM, run:  sudo ./guest/allow-path.sh ${TARGET%%@*} $(printf '%q' "$(dirname "$PWD")")"
        die "sync not possible until the path exists on the VM and is owned by you"
    fi
}

start_sync() {
    local name pattern ignore_args=()
    sync_enabled || return 0
    command -v mutagen >/dev/null 2>&1 ||
        die "mutagen not found. Install it (https://mutagen.io) or set DEVHOST_NO_SYNC=1 for ports only."
    name="$(sync_name)"
    if sync_exists; then
        return 0
    fi
    ensure_remote_dir
    while read -r pattern; do
        ignore_args+=(--ignore "$pattern")
    done < <(sync_ignore_patterns)
    log "syncing $PWD -> $TARGET:$PWD"
    mutagen sync create --name "$name" --label devhost=1 --sync-mode two-way-resolved \
        "${ignore_args[@]}" "$PWD" "$(sync_beta_url)" >/dev/null ||
        die "mutagen sync create failed"
}

# Waits for the sync to settle; warns about files Mutagen cannot update.
flush_sync() {
    local name status
    sync_enabled || return 0
    name="$(sync_name)"
    sync_exists || return 0
    if ! mutagen sync flush "$name" >/dev/null 2>&1; then
        log "warning: mutagen sync flush failed; outputs may be stale (devhost status for details)"
    fi
    status="$(mutagen sync list "$name" 2>/dev/null || true)"
    if grep -qi 'permission denied' <<< "$status"; then
        log "warning: sync reports permission problems. A container probably ran as root and left"
        log "root-owned files on the VM, which Mutagen cannot update or delete. See README."
    fi
}

stop_sync() {
    sync_enabled || return 0
    if sync_exists; then
        mutagen sync terminate "$(sync_name)" >/dev/null 2>&1 || log "warning: mutagen sync terminate failed"
    fi
}

# --------------------------------------------------------------- sessions

session_id() { printf '%s' "$PWD" | cksum | cut -d' ' -f1; }
session_registered() { [[ -f "$SESSIONS_DIR/$(session_id)" ]]; }
register_session() { echo "$PWD" > "$SESSIONS_DIR/$(session_id)"; }
unregister_session() { rm -f "$SESSIONS_DIR/$(session_id)"; }
sessions_remaining() { [[ -n "$(ls -A "$SESSIONS_DIR" 2>/dev/null)" ]]; }

# --------------------------------------------------------------- commands

cmd_probe() {
    local rc=0
    resolve_target
    # ControlPath=none: never reuse a shared master, whose liveness we can't bound.
    # shellcheck disable=SC2046
    with_deadline 5 ssh "${SSH_OPTS[@]}" $(ssh_port_opts) -o ConnectTimeout=3 -o ControlPath=none \
        "$TARGET" docker version --format '{{.Server.Version}}' >/dev/null 2>&1 || rc=$?
    if [[ $rc -eq 0 ]]; then
        echo "devhost ($TARGET) is up"
        return 0
    fi
    echo "devhost ($TARGET) is not reachable"
    return 1
}

cmd_up() {
    init_state
    resolve_target
    if session_registered; then
        log "$PWD is already up"
        return 0
    fi
    docker --context "$CONTEXT" ps -q >/dev/null 2>&1 ||
        die "cannot reach the daemon on context '$CONTEXT' (try: devhost probe)"
    start_master
    start_forwarder
    start_sync
    register_session
    log "up: forwarding published ports to 127.0.0.1; $(sync_enabled && echo "syncing $PWD" || echo "sync disabled")"
    report_conflicts || true
}

cmd_down() {
    init_state
    resolve_target
    if session_registered; then
        flush_sync
        stop_sync
        unregister_session
    fi
    if ! sessions_remaining; then
        stop_forwarder
        stop_master
        rm -f "$FORWARDS_FILE" "$CONFLICTS_FILE"
    fi
    log "down"
}

cmd_flush() {
    init_state
    resolve_target
    session_registered || die "$PWD is not up (run: devhost up)"
    flush_sync
    log "flushed"
}

RUN_NESTED=0
RUN_DONE=0
run_cleanup() {
    [[ $RUN_DONE -eq 0 ]] || return 0
    RUN_DONE=1
    if [[ $RUN_NESTED -eq 0 ]]; then
        cmd_down
    else
        flush_sync
    fi
}

cmd_run() {
    local rc=0
    [[ "${1:-}" == "--" ]] && shift
    [[ $# -gt 0 ]] || die "usage: devhost run [--] <command...>"
    init_state
    resolve_target
    trap 'run_cleanup' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if session_registered; then
        RUN_NESTED=1
    else
        cmd_up
        # Conflicts found before the command even ran: refuse rather than let the
        # project talk to whatever holds the port on this laptop.
        [[ -s "$CONFLICTS_FILE" ]] && exit 1
    fi
    flush_sync
    set +e
    DOCKER_CONTEXT="$CONTEXT" "$@"
    rc=$?
    set -e
    # Flushes outputs back (also when the command failed), then tears down.
    run_cleanup
    if [[ $RUN_NESTED -eq 0 ]]; then
        if ! report_conflicts && [[ $rc -eq 0 ]]; then
            rc=1
        fi
    fi
    exit "$rc"
}

cmd_status() {
    local port cid name dir
    init_state
    resolve_target
    echo "context:    $CONTEXT ($TARGET${SSH_PORT:+ port $SSH_PORT})"
    if cmd_probe >/dev/null 2>&1; then
        echo "daemon:     reachable"
    else
        echo "daemon:     NOT reachable"
    fi
    if master_running; then
        echo "ssh master: running ($SOCK)"
    else
        echo "ssh master: not running"
    fi
    if forwarder_running; then
        echo "forwarder:  running (pid $(forwarder_pid))"
    else
        echo "forwarder:  not running"
    fi
    if [[ -s "$FORWARDS_FILE" ]]; then
        echo "forwards:"
        while read -r port cid name; do
            [[ -n "$port" ]] || continue
            echo "  127.0.0.1:$port -> $name (${cid:0:12})"
        done < "$FORWARDS_FILE"
    else
        echo "forwards:   none"
    fi
    if [[ -s "$CONFLICTS_FILE" ]]; then
        echo "conflicts:"
        while IFS='|' read -r port cid name _; do
            echo "  127.0.0.1:$port -> $name (${cid:0:12}) NOT forwarded"
        done < "$CONFLICTS_FILE"
    fi
    if sessions_remaining; then
        echo "up in:"
        for dir in "$SESSIONS_DIR"/*; do
            echo "  $(cat "$dir")"
        done
    else
        echo "up in:      no directories"
    fi
    if sync_enabled && command -v mutagen >/dev/null 2>&1; then
        if sync_exists; then
            echo "sync ($PWD):"
            mutagen sync list "$(sync_name)" 2>/dev/null | sed 's/^/  /' || true
        else
            echo "sync:       none for $PWD"
        fi
    fi
}

usage() {
    sed -n '2,/^# Requires/p' "$SELF" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

main() {
    set -euo pipefail
    local cmd="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$cmd" in
        run)        cmd_run "$@" ;;
        up)         cmd_up ;;
        down)       cmd_down ;;
        flush)      cmd_flush ;;
        status)     cmd_status ;;
        probe)      cmd_probe ;;
        _forwarder) init_state; forwarder_main ;;
        -h|--help|help|'') usage ;;
        *)          log "unknown command: $cmd"; usage ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
